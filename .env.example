# App
NODE_ENV=development
PORT=8020

# Local JWT — used for unit tests and offline smoke when Supabase is unset.
# Keep set even in production if you want HS256 test tokens; not used to verify Supabase user JWTs.
JWT_SECRET=local-dev-secret-change-me

# Database — dedicated Cremation Tracker Supabase/Postgres (required with Supabase auth)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cremation_tracker

# Supabase Auth (production / staging) — leave unset to use local JWT auth
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=replace-with-anon-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# CORS — comma-separated exact origins
ALLOWED_ORIGINS=http://localhost:8020,http://localhost:8080,http://localhost:5173

# Staff invites (optional SendGrid). Without these, invites still work and the
# invite token is returned in the API response / server logs.
# SENDGRID_API_KEY=
# INVITE_FROM_EMAIL=noreply@yourdomain.com
# INVITE_FROM_NAME=Cremation Tracker
# INVITE_SIGNUP_URL=http://localhost:8080/
# INVITE_TOKEN_TTL_DAYS=7

# API docs (Swagger UI at /docs). Set ENABLE_SWAGGER_UI=false to hide in production.
# SWAGGER_SERVER_URL=http://localhost:8020

# Family portal base URL (used to build shareable /f/:token links)
FAMILY_PORTAL_BASE_URL=http://localhost:5173

# Billing — per live case after free credits; default $7.99 (adjust CASE_PRICE_CENTS)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
CASE_PRICE_CENTS=799
FREE_LIVE_CASES_PER_ORG=3
# When STRIPE_SECRET_KEY is unset, checkout mock-pays in non-production.
# ALLOW_MOCK_BILLING=true
# BILLING_SUCCESS_URL=https://cremationtracker.app/billing/success
# BILLING_CANCEL_URL=https://cremationtracker.app/billing/cancel
